[2.153681, "o", "\u001b[0;34m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n\u001b[0;32m✓ Demo Complete\u001b[0m\r\n\u001b[0;34m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n\r\n  \u001b[0;34mMCP Server:\u001b[0m skillsguard setup\r\n  \u001b[0;34mCLI:\u001b[0m        skillsguard /path/to/skill\r\n  \u001b[0;34mCloud API:\u001b[0m  curl --data-binary @SKILL.md \\\r\n             https://skillsguard.apiskillsguard.workers.dev/scan\r\n\r\n\u001b[0;34m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n\u001b[0;32mgithub.com/Teycir/SkillsGuard\u001b[0m\r\n\u001b[0;34m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n"]
