{
  "name": "skillsguard",
  "version": "1.1.1",
  "description": "Static security scanner for AI agent Skills (SKILL.md + bundled scripts). Zero runtime dependencies.",
  "keywords": [
    "security",
    "scanner",
    "ai-agent",
    "skill",
    "SKILL.md",
    "prompt-injection",
    "static-analysis",
    "mcp",
    "claude",
    "agent-security",
    "skill-audit",
    "ai-security",
    "llm-security",
    "codex",
    "lazycodex"
  ],
  "homepage": "https://github.com/Teycir/SkillsGuard",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Teycir/SkillsGuard.git"
  },
  "bugs": {
    "url": "https://github.com/Teycir/SkillsGuard/issues"
  },
  "type": "module",
  "bin": {
    "skillsguard": "dist/cli.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "llm.txt"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:test": "tsc -p tsconfig.test.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test:unit": "node --test dist-test/tests/*.test.js dist-test/tests/**/*.test.js",
    "test:fixtures": "node testskills/run-tests.js",
    "test": "npm run build && npm run build:test && npm run test:unit && npm run test:fixtures"
  },
  "engines": {
    "node": ">=18.3.0"
  },
  "license": "MIT",
  "author": "Teycir",
  "devDependencies": {
    "typescript": "^5.5.0",
    "@types/node": "^20.14.0"
  }
}
